rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOneOfOurTwo() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'you@example.com',
          'girlfriend@example.com'
        ];
    }

    function isSharedCollection(coupleId, collection) {
      return coupleId == 'main'
        && collection in ['settings', 'memories', 'letters', 'bucket']
        && isOneOfOurTwo();
    }

    match /couples/{coupleId}/{collection}/{documentId} {
      allow read: if isSharedCollection(coupleId, collection);
      allow create: if isSharedCollection(coupleId, collection)
        && (collection != 'letters'
          || request.resource.data.authorEmail == request.auth.token.email);
      allow update: if isSharedCollection(coupleId, collection)
        && (collection != 'letters'
          || (
            resource.data.keys().hasAny(['authorEmail'])
            && request.resource.data.authorEmail == resource.data.authorEmail
          )
          || (
            !resource.data.keys().hasAny(['authorEmail'])
            && !request.resource.data.keys().hasAny(['authorEmail'])
          ));
      allow delete: if isSharedCollection(coupleId, collection)
        && (collection != 'letters'
          || resource.data.authorEmail == request.auth.token.email);
    }
  }
}
